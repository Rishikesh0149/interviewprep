# PrepPilot Environment Configuration
PROJECT_NAME=PrepPilot
VERSION=1.0.0
SECRET_KEY=super-secret-jwt-key-change-this-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (defaults to SQLite; swap to PostgreSQL for production)
DATABASE_URL=sqlite:///./preppilot.db
# DATABASE_URL=postgresql://preppilot:preppilot_pwd@localhost:5432/preppilot_db

# Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5

# AI Provider ("gemini" | "openai" | "claude" | "mock")
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
